<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  OMMFA sitemap.xml — 放在网站根目录

  这是手写的。netlify.toml 里的 @netlify/plugin-sitemap 已移除，
  不会再有东西覆盖这个文件。

  【每次加页面都要回来加一段】
  静态站没有自动机制。新增一个 journal 文章页或项目页，
  就在对应区块复制一段 <url> 改掉 loc。

  网址不带 .html —— 这是照着现有页面的 canonical 写的
  （journal.html 里写的是 https://ommfa.org/journal，
    human.html 里写的是 https://ommfa.org/human）。
  sitemap 和 canonical 必须一致，否则 Google 会认为
  同一内容有两个地址，收录权重被稀释。

  lastmod 要如实反映内容最后一次实质修改。
  每次部署都改成今天，Google 会学会忽略它。
  下面的日期是估的，请按实际改。
  ============================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- ===== 主要页面 ===== -->

  <url>
    <loc>https://ommfa.org/</loc>
    <lastmod>2026-08-14</lastmod>
  </url>

  <url>
    <loc>https://ommfa.org/about</loc>
    <lastmod>2026-08-14</lastmod>
  </url>

  <url>
    <loc>https://ommfa.org/threads</loc>
    <lastmod>2026-08-14</lastmod>
  </url>

  <url>
    <loc>https://ommfa.org/journal</loc>
    <lastmod>2026-08-14</lastmod>
  </url>

  <!-- 原 /artist，已改名。旧地址由 netlify.toml 的 301 跳到这里，
       sitemap 里只收新地址，不要把 /artist 也列进来 -->
  <url>
    <loc>https://ommfa.org/human</loc>
    <lastmod>2026-08-14</lastmod>
  </url>


  <!-- ===== 项目页 ===== -->

  <url>
    <loc>https://ommfa.org/projects/london-design-festival-2026</loc>
